{
  "name": "deanmachine",
  "version": "1.0.0",
  "description": "Multi-server Discord bot with pluggable skills",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "build": "bash build.sh"
  },
  "pkg": {
    "scripts": [
      "Skills/*/skill.js"
    ],
    "assets": [
      "Skills/*/strings.yaml"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ]
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
