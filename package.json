{
  "name": "deanmachine",
  "version": "1.0.0",
  "description": "Simple multi-server Discord bot with a job loop",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --out-path dist"
  },
  "pkg": {
    "scripts": [
      "Jobs/*/job.js"
    ],
    "assets": [
      "strings.yaml",
      "Jobs/*/strings.yaml"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ]
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
